# ──────────────────────────────────────────────
# FormFriend Team B Backend — Environment Config
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000

# AWS Region (must match the region where your Cognito and DynamoDB are created)
AWS_REGION=ap-south-1

# ── Amazon Cognito ───────────────────────────
# Get these from the AWS Console → Cognito → User Pools → your pool
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── Amazon DynamoDB ──────────────────────────
# Table name — must match the table you created (or the SAM template creates)
DYNAMODB_TABLE_NAME=Profiles

# ── Upstash Redis ────────────────────────────
# Get these from https://console.upstash.com → your Redis database → Details tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PROFILE_TTL_SECONDS=3600

# ── Encryption ───────────────────────────────
# 32-byte key, Base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_B64=

# ── CORS ─────────────────────────────────────
# Allowed origin for CORS (use * for development, restrict in production)
CORS_ORIGIN=*
